+func parseBackchannel(fragment string) (bool, error) {
+	if fragment == "" {
+		return true, nil
+	}
+
+	query, err := url.ParseQuery(strings.ReplaceAll(fragment, "#", "&"))
+	if err != nil {
+		return false, fmt.Errorf("xiaomi: invalid source options: %w", err)
+	}
+	return query.Get("backchannel") != "0", nil
+}
