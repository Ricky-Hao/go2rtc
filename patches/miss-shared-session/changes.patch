+	st.ch <- &Packet{CodecID: codecPCMU, Sequence: 1, Payload: []byte{0x7F, 0x7E, 0x7D, 0x7C}}
+	st.ch <- &Packet{CodecID: codecPCM, Sequence: 2, Payload: []byte{1, 0, 2, 0}}
