+	m := newSessionManager(func(string) (sessionClient, error) { count++; return newFakeClient(), nil })
+	const source = "xiaomi://user:cn@host?did=1&vendor=cs2"
+	s, st, err := m.acquire(testURL(t, source), 1, audioDisabled)
+	require.NoError(t, err)
+	for _, raw := range []string{"xiaomi://other:cn@host?did=1&vendor=cs2", "xiaomi://user:tw@host?did=1&vendor=cs2", source + "&transport=tcp", source + "&device_public=different", "xiaomi://host?did=1&vendor=cs2"} {
+		_, _, err = m.acquire(testURL(t, raw), 0, audioDisabled)
+		require.Error(t, err)
+	}
+	_, peer, err := m.acquire(testURL(t, source+"&transport=udp&sign=renewed"), 1, audioDisabled)
+	require.NoError(t, err)
+	require.NoError(t, s.startMedia(1, "2"))
+	require.Error(t, s.startMedia(1, "1"))
+	require.Equal(t, 1, count)
+	require.NoError(t, peer.Close())
+	require.NoError(t, st.Close())
+	_, st, err = m.acquire(testURL(t, "xiaomi://host?client_private=one"), 0, audioDisabled)
+	require.NoError(t, err)
+	_, _, err = m.acquire(testURL(t, "xiaomi://host?client_private=two"), 0, audioDisabled)
+	require.Error(t, err)
+	require.NoError(t, st.Close())
+}
+
+func TestSessionManagerDefaultPorts(t *testing.T) {
+	for vendor, port := range map[string]string{"cs2": "32108", "tutk": "32761"} {
+		t.Run(vendor, func(t *testing.T) {
+			m := newSessionManager(func(string) (sessionClient, error) { return newFakeClient(), nil })
+			open := func(port string) *stream {
+				t.Helper()
+				u := testURL(t, "xiaomi://192.0.2.10"+port+"?vendor="+vendor)
+				_, st, err := m.acquire(u, 0, audioDisabled)
+				require.NoError(t, err)
+				t.Cleanup(func() { _ = st.Close() })
+				return st
+			}
+			first := open("")
+			require.Same(t, first.session, open(":"+port).session)
+			require.NotSame(t, first.session, open(":10001").session)
+		})
+	}
+}
+
+func TestParseChannel(t *testing.T) {
+	query := url.Values{}
+	channel, err := parseChannel(query)
+	require.NoError(t, err)
+	require.Equal(t, uint8(0), channel)
+
+	query.Set("channel", "0")
+	channel, err = parseChannel(query)
+	require.NoError(t, err)
+	require.Equal(t, uint8(0), channel)
+
+	query.Set("channel", "1")
+	channel, err = parseChannel(query)
+	require.NoError(t, err)
+	require.Equal(t, uint8(1), channel)
+
+	query.Set("channel", "2")
+	_, err = parseChannel(query)
+	require.Error(t, err)
+}
