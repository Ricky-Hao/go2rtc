+func TestSessionManagerConcurrentAcquireDialsOnce(t *testing.T) {
+	entered := make(chan struct{}, 2)
+	var count atomic.Int32
+	release := make(chan struct{})
+	m := newSessionManager(func(raw string) (sessionClient, error) {
+		if raw == "xiaomi://slow" {
+			count.Add(1)
+			entered <- struct{}{}
+			<-release
+		}
+		return newFakeClient(), nil
+	})
+	results := make(chan *stream, 2)
+	for ch := range uint8(2) {
+		go func() {
+			_, st, err := m.acquire(testURL(t, "xiaomi://slow"), ch, audioDisabled)
+			if err != nil {
+				t.Error(err)
+			}
+			results <- st
+		}()
+	}
+	<-entered
+	require.EqualValues(t, 1, count.Load())
+	_, other, err := m.acquire(testURL(t, "xiaomi://other"), 0, audioDisabled)
+	require.NoError(t, err)
+	require.NoError(t, other.Close())
+	close(release)
+	a, b := <-results, <-results
+	require.EqualValues(t, 1, count.Load())
+	require.Same(t, a.session, b.session)
+	require.NoError(t, a.Close())
+	require.NoError(t, b.Close())
+}
