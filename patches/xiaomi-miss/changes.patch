+		}
+		close(st.done)
+	}()
+}
+
+func testH264Packet(t *testing.T) *Packet {
+	t.Helper()
+
+	avcc, err := hex.DecodeString("000000196764001fac2484014016ec0440000003004000000c23c60c920000000568ee32c8b0000000d365")
+	require.NoError(t, err)
+
+	return &Packet{
+		CodecID: codecH264,
+		Payload: annexb.DecodeAVCC(avcc, true),
+	}
+}
+
+func TestProbeNegotiatesVideoThenOpus(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		s := newSession(newFakeClient(), "", nil)
+		st := newTestStream(s)
+		st.ch <- testH264Packet(t)
+		audio := &Packet{CodecID: codecOPUS, Payload: []byte{0xf8, 0xff, 0xfe}}
+		time.AfterFunc(500*time.Millisecond, func() { st.ch <- audio })
+		start := time.Now()
+		medias, err := probe(st, true, false)
+		require.NoError(t, err)
+		require.Equal(t, 500*time.Millisecond, time.Since(start))
+		require.Len(t, medias, 2)
+		require.Equal(t, core.CodecOpus, medias[1].Codecs[0].Name)
+		recv := core.NewReceiver(medias[1], medias[1].Codecs[0])
+		p := &Producer{Connection: core.Connection{Receivers: []*core.Receiver{recv}}, stream: st}
+		st.ch <- audio
+		closeWhenDrained(st)
+		require.ErrorIs(t, p.Start(), io.EOF)
+		require.Equal(t, 1, recv.Packets)
+	})
+}
+
+func TestDialSharesBothLensesAndDuplicateReader(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		client := newFakeClient()
+		client.media = make(chan *Packet, 4)
+		dials := 0
+		old := defaultSessionManager
+		defer func() { defaultSessionManager = old }()
+		defaultSessionManager = newSessionManager(func(string) (sessionClient, error) {
+			dials++
+			return client, nil
+		})
+		open := func(options string, pkt *Packet, codec string) (core.Producer, *core.Receiver) {
+			t.Helper()
+			go func() {
+				synctest.Wait()
+				client.media <- pkt
+			}()
+			p, err := Dial("xiaomi://camera?model=" + ModelC300 + "&audio=0&" + options + "#backchannel=0")
+			require.NoError(t, err)
+			medias := p.GetMedias()
+			require.Len(t, medias, 1)
+			require.Equal(t, codec, medias[0].Codecs[0].Name)
+			r, err := p.GetTrack(medias[0], medias[0].Codecs[0])
+			require.NoError(t, err)
+			return p, r
+		}
+		secondary := testH264Packet(t)
+		secondary.Channel, secondary.ChannelOK = 1, true
+		a, ar := open("channel=1&subtype=hd", secondary, core.CodecH264)
+		b, br := open("channel=1&subtype=3", secondary, core.CodecH264)
+		vps, err := hex.DecodeString("0000000140010c01ffff016000000300900000030000030078959809")
+		require.NoError(t, err)
+		primary := &Packet{CodecID: codecH265, ChannelOK: true, Payload: vps}
+		c, cr := open("channel=0&subtype=sd", primary, core.CodecH265)
+		done := make(chan error, 3)
+		for _, p := range []core.Producer{a, b, c} {
+			go func() { done <- p.Start() }()
+		}
+		synctest.Wait()
+		beforeA, beforeB := ar.Packets, br.Packets
+		client.media <- secondary
+		client.media <- primary
+		synctest.Wait()
+		require.Equal(t, beforeA+1, ar.Packets)
+		require.Equal(t, beforeB+1, br.Packets)
+		require.Equal(t, 1, cr.Packets)
+		require.Equal(t, 1, dials)
+		_, _, dual, singles := client.counts()
+		require.Equal(t, []string{"1"}, singles)
+		require.Equal(t, 1, dual)
+		for _, p := range []core.Producer{a, b, c} {
+			require.NoError(t, p.Stop())
+		}
+		for range 3 {
+			require.ErrorIs(t, <-done, io.EOF)
+		}
+	})
+}
+
+func TestSessionVideoTimeoutKeepsPeer(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		client := newFakeClient()
+		m := newSessionManager(func(string) (sessionClient, error) { return client, nil })
+		u := testURL(t, "xiaomi://host")
+		s, a, err := m.acquire(u, 0, audioVideoStart)
+		require.NoError(t, err)
+		require.NoError(t, s.startMedia(0, "hd"))
+		_, b, err := m.acquire(u, 1, audioVideoStart)
+		require.NoError(t, err)
+		require.NoError(t, s.startMedia(1, "hd"))
+		result := make(chan error, 1)
+		go func() { p := Producer{stream: b}; result <- p.Start() }()
+		synctest.Wait()
+		video := testH264Packet(t)
+		video.ChannelOK = true
+		s.dispatch(video)
+		for range 11 {
+			s.dispatch(&Packet{CodecID: codecPCMA})
+			s.dispatch(video)
+			time.Sleep(time.Second)
+		}
+		require.ErrorIs(t, <-result, os.ErrDeadlineExceeded)
+		stop, closed, _, _ := client.counts()
+		require.Zero(t, stop)
+		require.Zero(t, closed)
+		_, replacement, err := m.acquire(u, 1, audioDisabled)
+		require.NoError(t, err)
+		require.NoError(t, s.startMedia(1, "hd"))
+		_, _, dual, _ := client.counts()
+		require.Equal(t, 2, dual)
+		require.NoError(t, replacement.Close())
+		require.NoError(t, a.Close())
+	})
+}
diff --git a/pkg/xiaomi/miss/session.go b/pkg/xiaomi/miss/session.go
new file mode 100644
index 0000000000000000000000000000000000000000..568aa99a821755d6ea0f5dc6368872b51607e4e2
--- /dev/null
+++ b/pkg/xiaomi/miss/session.go
@@ -0,0 +1,401 @@
+package miss
+
+import (
+	"errors"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+// session manages a single MISS client connection that can serve multiple
+// streams (channels). For dual-channel cameras, both channel 0 and channel 1
+// share the same underlying UDP/TCP session to avoid exhausting the camera's
+// limited connection slots.
+type session struct {
+	client  sessionClient
+	key     string // physical endpoint
+	scope   [32]byte
+	manager *sessionManager
+	mu      sync.Mutex
+	streams map[*stream]struct{} // nil once shutdown owns the client
+
+	// startedMask tracks which channels have been started (bit 0 = ch0, bit 1 = ch1).
+	startedMask  uint8
+	restartMask  uint8
+	quality      [2]string // configured while the channel has readers
+	mediaAudio   bool
+	audioStarted bool
+
+	workerDone chan struct{}
+
+	speakerStarted bool
+	audioWriteMu   sync.Mutex // shared transport assigns one outgoing audio sequence
+
+	audioCodec *core.Codec
+	classifier *packetClassifier
+}
+
+// stream represents a single channel's view of a session. It receives
+// packets dispatched by the session worker and provides a ReadPacket
+// interface compatible with what the Producer expects.
+type stream struct {
+	session *session
+	channel uint8
+	audio   audioMode
+	ch      chan *Packet
+
+	done chan struct{}
+}
+
+type sessionClient interface {
+	Protocol() string
+	Version() string
+	IsDafangLike() bool
+	StartMedia(channel, quality, audio string) error
+	StartMediaDual(quality0, quality1, audio string) error
+	StartAudio() error
+	StopMedia() error
+	StartSpeaker() error
+	SpeakerCodec() uint32
+	WriteAudio(codecID uint32, payload []byte) error
+	ReadPacket() (*Packet, error)
+	RemoteAddr() net.Addr
+	SetDeadline(t time.Time) error
+	Close() error
+}
+
+const (
+	mediaTimeout      = 10 * time.Second
+	stopMediaTimeout  = time.Second
+	workerStopTimeout = time.Second
+)
+
+var errSessionClosing = errors.New("miss: session is closing")
+
+type audioMode uint8
+
+const (
+	audioDisabled audioMode = iota
+	audioVideoStart
+	audioCommandStart
+)
+
+func parseAudioMode(raw string) audioMode {
+	switch raw {
+	case "0":
+		return audioDisabled
+	case "2":
+		return audioCommandStart
+	default:
+		return audioVideoStart
+	}
+}
+
+func (m audioMode) enabled() bool {
+	return m != audioDisabled
+}
+
+func newSession(client sessionClient, key string, manager *sessionManager) *session {
+	return &session{
+		client:     client,
+		key:        key,
+		manager:    manager,
+		streams:    make(map[*stream]struct{}),
+		workerDone: make(chan struct{}),
+		classifier: newPacketClassifier(),
+	}
+}
+
+// openStream creates a new stream for the given channel on this session.
+func (s *session) openStream(channel uint8, audio audioMode) (*stream, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.streams == nil {
+		return nil, errSessionClosing
+	}
+	if len(s.streams) == 0 {
+		go s.worker()
+	}
+
+	st := &stream{
+		session: s,
+		channel: channel,
+		audio:   audio,
+		ch:      make(chan *Packet, 100),
+		done:    make(chan struct{}),
+	}
+
+	s.streams[st] = struct{}{}
+	return st, nil
+}
+
+// startMedia sends the appropriate VideoStart command. If only one channel is
+// active, it sends a single-channel command. If both channels are active, it
+// sends a dual-channel command.
+func (s *session) startMedia(channel uint8, quality string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.streams == nil {
+		return errSessionClosing
+	}
+	bit := uint8(1 << channel)
+	if s.quality[channel] != "" && s.quality[channel] != quality {
+		return errors.New("miss: conflicting quality on active channel")
+	}
+	var audio audioMode
+	for st := range s.streams {
+		audio = max(audio, st.audio)
+	}
+	if s.quality[channel] == "" || s.restartMask&bit != 0 || (audio.enabled() && !s.mediaAudio) {
+		qualities := s.quality
+		qualities[channel] = quality
+		mask := bit
+		if qualities[1-channel] != "" {
+			mask = 3
+		}
+		enableAudio := "0"
+		if audio.enabled() {
+			enableAudio = "1"
+		}
+		var err error
+		if mask == 3 {
+			err = s.client.StartMediaDual(qualities[0], qualities[1], enableAudio)
+		} else {
+			err = s.client.StartMedia(strconv.Itoa(int(channel)), quality, enableAudio)
+		}
+		if err != nil {
+			return err
+		}
+		s.quality = qualities
+		s.startedMask = mask
+		s.restartMask &^= mask
+		s.mediaAudio = audio.enabled()
+		s.audioStarted = false
+	}
+	if !s.audioStarted && audio.enabled() && !s.client.IsDafangLike() && (s.startedMask == 3 || audio == audioCommandStart) {
+		// Video can still be used after an optional audio command fails.
+		s.audioStarted = s.client.StartAudio() == nil
+	}
+	return nil
+}
+
+// worker is the read loop that dispatches packets to streams.
+func (s *session) worker() {
+	defer close(s.workerDone)
+
+	for {
+		_ = s.client.SetDeadline(time.Now().Add(mediaTimeout))
+
+		pkt, err := s.client.ReadPacket()
+		if err != nil {
+			s.readFailed()
+			return
+		}
+
+		s.dispatch(pkt)
+	}
+}
+
+// dispatch routes a packet to the appropriate stream(s).
+func (s *session) dispatch(pkt *Packet) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if isAudioCodec(pkt.CodecID) {
+		if s.audioCodec == nil {
+			s.audioCodec = audioCodecFromPacket(pkt)
+		}
+		for st := range s.streams {
+			if st.audio.enabled() {
+				st.push(pkt)
+			}
+		}
+		return
+	}
+	mask := s.startedMask
+	if mask == 3 {
+		// If the device is still sending both lenses after one unsubscribed,
+		// keep routing unknown packets to the remaining lens until we can classify.
+		var subscribed uint8
+		for st := range s.streams {
+			subscribed |= 1 << st.channel
+		}
+		if subscribed == 3 {
+			mask = 1 << s.classifier.Classify(pkt)
+		} else if ch, ok := s.classifier.ClassifyKnown(pkt); ok {
+			mask = 1 << ch
+		} else {
+			mask = subscribed
+		}
+	}
+	for st := range s.streams {
+		if mask&(1<<st.channel) != 0 {
+			st.push(pkt)
+		}
+	}
+}
+
+func (s *session) startSpeaker() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.streams == nil {
+		return errSessionClosing
+	}
+	if !s.speakerStarted {
+		if err := s.client.StartSpeaker(); err != nil {
+			return err
+		}
+		s.speakerStarted = true
+	}
+	return nil
+}
+
+func (s *session) writeAudio(codecID uint32, payload []byte) error {
+	s.audioWriteMu.Lock()
+	defer s.audioWriteMu.Unlock()
+	return s.client.WriteAudio(codecID, payload)
+}
+
+func (s *session) cachedAudioCodec() *core.Codec {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if s.audioCodec == nil {
+		return nil
+	}
+	return s.audioCodec.Clone()
+}
+
+func (s *session) talkCodec() *core.Codec {
+	switch s.client.SpeakerCodec() {
+	case codecOPUS:
+		return &core.Codec{Name: core.CodecOpus, ClockRate: 48000, Channels: 2}
+	default:
+		return &core.Codec{Name: core.CodecPCMA, ClockRate: 8000}
+	}
+}
+
+// removeStream removes a stream from the session. If no streams remain, the
+// session is shut down.
+func (s *session) removeStream(st *stream, videoTimeout bool) {
+	s.mu.Lock()
+	if _, ok := s.streams[st]; !ok {
+		s.mu.Unlock()
+		return
+	}
+	delete(s.streams, st)
+	last := len(s.streams) == 0
+	if last {
+		s.streams = nil
+	} else if !s.hasChannelLocked(st.channel) {
+		s.quality[st.channel] = ""
+	} else if videoTimeout {
+		s.restartMask |= 1 << st.channel
+	}
+	s.mu.Unlock()
+	if last {
+		s.stopMedia()
+		s.closeClient()
+	}
+	close(st.done)
+	if last {
+		s.waitWorkerDone()
+	}
+}
+
+func (s *session) hasChannelLocked(channel uint8) bool {
+	for st := range s.streams {
+		if st.channel == channel {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *session) readFailed() {
+	s.mu.Lock()
+	streams := s.streams
+	s.streams = nil
+	s.mu.Unlock()
+	if streams == nil {
+		return
+	}
+	s.closeClient()
+	for st := range streams {
+		close(st.done)
+	}
+}
+
+func (s *session) closeClient() {
+	_ = s.client.Close()
+	if s.manager != nil {
+		s.manager.remove(s.key)
+	}
+}
+
+func (s *session) stopMedia() {
+	_ = s.client.SetDeadline(time.Now().Add(stopMediaTimeout))
+
+	done := make(chan struct{})
+	go func() {
+		_ = s.client.StopMedia()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+	case <-time.After(stopMediaTimeout):
+	}
+}
+
+func (s *session) waitWorkerDone() {
+	select {
+	case <-s.workerDone:
+	case <-time.After(workerStopTimeout):
+	}
+}
+
+// --- stream methods ---
+
+// The probe and producer each own an absolute deadline. Buffered audio must
+// not keep a stopped video channel alive.
+func (st *stream) readPacket(deadline time.Time) (*Packet, error) {
+	d := time.Until(deadline)
+	if d <= 0 {
+		return nil, os.ErrDeadlineExceeded
+	}
+	select {
+	case pkt := <-st.ch:
+		return pkt, nil
+	case <-st.done:
+		return nil, io.EOF
+	case <-time.After(d):
+		return nil, os.ErrDeadlineExceeded
+	}
+}
+
+// Close removes this stream from the session.
+func (st *stream) Close() error {
+	st.session.removeStream(st, false)
+	return nil
+}
+
+func (st *stream) push(pkt *Packet) {
+	select {
+	case st.ch <- pkt:
+	default:
+		// Drop packet if the buffer is full.
+	}
+}
+
+func isAudioCodec(codecID uint32) bool {
+	switch codecID {
+	case codecPCM, codecPCMU, codecPCMA, codecOPUS:
+		return true
+	}
+	return false
+}
diff --git a/pkg/xiaomi/miss/session_manager.go b/pkg/xiaomi/miss/session_manager.go
new file mode 100644
index 0000000000000000000000000000000000000000..7b0f501a5166f59f4d0cc99d4ef04d463ded8c9d
--- /dev/null
+++ b/pkg/xiaomi/miss/session_manager.go
@@ -0,0 +1,119 @@
+package miss
+
+import (
+	"crypto/sha256"
+	"errors"
+	"net/url"
+	"strings"
+	"sync"
+)
+
+type clientFactory func(string) (sessionClient, error)
+
+type cameraDial struct {
+	ready   chan struct{}
+	session *session
+	err     error
+}
+
+type sessionManager struct {
+	mu        sync.Mutex
+	sessions  map[string]*cameraDial
+	newClient clientFactory
+}
+
+var defaultSessionManager = newSessionManager(func(raw string) (sessionClient, error) { return NewClient(raw) })
+
+func newSessionManager(dial clientFactory) *sessionManager {
+	return &sessionManager{sessions: make(map[string]*cameraDial), newClient: dial}
+}
+
+// The cloud handler resolves a fresh signed key pair for the same account,
+// region and device. Direct sources instead authenticate with their supplied keys.
+func sessionScope(u *url.URL) [32]byte {
+	q := u.Query()
+	scope := url.Values{"account": {u.User.String()}}
+	for _, k := range []string{"did", "vendor", "model", "uid", "device_public"} {
+		scope.Set(k, q.Get(k))
+	}
+	if u.User == nil || q.Get("did") == "" {
+		for _, k := range []string{"client_public", "client_private", "sign"} {
+			scope.Set(k, q.Get(k))
+		}
+	}
+	return sha256.Sum256([]byte(scope.Encode()))
+}
+
+func (m *sessionManager) acquire(u *url.URL, channel uint8, audio audioMode) (*session, *stream, error) {
+	q := u.Query()
+	var s *session
+	if isDafangLike(q.Get("model")) {
+		client, err := m.newClient(u.String())
+		if err != nil {
+			return nil, nil, err
+		}
+		s = newSession(client, "", nil)
+	} else {
+		host := strings.ToLower(u.Host)
+		// The two transports also accept the camera address without their LAN port.
+		switch q.Get("vendor") {
+		case "cs2":
+			host = strings.TrimSuffix(host, ":32108")
+		case "tutk":
+			host = strings.TrimSuffix(host, ":32761")
+		}
+		scope := sessionScope(u)
+		var protocol string
+		if transport := q.Get("transport"); q.Get("vendor") == "cs2" && transport != "" {
+			protocol = "cs2+" + transport
+		}
+		m.mu.Lock()
+		dial, exists := m.sessions[host]
+		if !exists {
+			dial = &cameraDial{ready: make(chan struct{})}
+			m.sessions[host] = dial
+		}
+		m.mu.Unlock()
+		if exists {
+			<-dial.ready
+		} else {
+			client, err := m.newClient(u.String())
+			if err == nil && protocol != "" && client.Protocol() != protocol {
+				_ = client.Close()
+				err = errIncompatibleTransport
+			}
+			if err != nil {
+				dial.err = err
+				m.remove(host)
+			} else {
+				dial.session = newSession(client, host, m)
+				dial.session.scope = scope
+			}
+			close(dial.ready)
+		}
+		if dial.err != nil {
+			return nil, nil, dial.err
+		}
+		s = dial.session
+		if s.scope != scope {
+			return nil, nil, errors.New("miss: incompatible camera credentials or model")
+		}
+		if exists && protocol != "" && s.client.Protocol() != protocol {
+			return nil, nil, errIncompatibleTransport
+		}
+	}
+	st, err := s.openStream(channel, audio)
+	if err != nil {
+		return nil, nil, err
+	}
+	return s, st, nil
+}
+
+var errIncompatibleTransport = errors.New("miss: incompatible camera transport")
+
+// Only the dial owner or the session that has just closed releases its slot.
+func (m *sessionManager) remove(host string) {
+	m.mu.Lock()
+	delete(m.sessions, host)
+	m.mu.Unlock()
+}
