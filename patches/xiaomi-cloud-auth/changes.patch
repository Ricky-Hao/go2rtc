+// A login owns its result even if a token change replaces the cache entry.
+type cloudLogin struct {
+	ready  chan struct{}
+	client cloudClient
+	err    error
+}
+
+func getCloud(userID string, stale *cloudLogin) (*cloudLogin, error) {
+	cloudsMu.Lock()
+	if login := clouds[userID]; login != nil && login != stale {
+		cloudsMu.Unlock()
+		<-login.ready
+		return login, login.err
+	}
+	token := tokens[userID]
+	login := &cloudLogin{ready: make(chan struct{})}
+	clouds[userID] = login
+	cloudsMu.Unlock()
