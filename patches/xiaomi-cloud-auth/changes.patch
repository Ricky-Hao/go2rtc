+package xiaomi
+
+import (
+	"encoding/base64"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCloudRequestStatusAndAPIError(t *testing.T) {
+	c := NewCloud("fixture")
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/expired":
+			w.WriteHeader(http.StatusUnauthorized)
+		case "/forbidden":
+			w.WriteHeader(http.StatusForbidden)
+		default:
+			nonce, err := base64.StdEncoding.DecodeString(r.FormValue("_nonce"))
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			body, err := crypt(genSignedNonce(c.ssecurity, nonce), []byte(`{"code":-1,"message":"vendor unavailable"}`))
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			_, _ = w.Write([]byte(base64.StdEncoding.EncodeToString(body)))
+		}
+	}))
+	defer srv.Close()
+	_, err := c.Request(srv.URL, "/expired", "{}", nil)
+	require.ErrorIs(t, err, ErrUnauthorized)
+	_, err = c.Request(srv.URL, "/forbidden", "{}", nil)
+	var status *StatusError
+	require.ErrorAs(t, err, &status)
+	require.Equal(t, http.StatusForbidden, status.StatusCode)
+	require.NotErrorIs(t, err, ErrUnauthorized)
+	_, err = c.Request(srv.URL, "/vendor", "{}", nil)
+	require.EqualError(t, err, "xiaomi: vendor unavailable")
+}
